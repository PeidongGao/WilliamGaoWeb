{
  "name": "william-gao-web",
  "version": "0.8.1.1",
  "description": "Asset build scripts for William Peidong Gao's personal academic website",
  "repository": {
    "type": "git",
    "url": "https://github.com/PeidongGao/WilliamGaoWeb"
  },
  "keywords": [
    "jekyll",
    "academic-website",
    "personal-website"
  ],
  "contributors": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PeidongGao/WilliamGaoWeb/issues"
  },
  "homepage": "https://peidonggao.github.io/WilliamGaoWeb/",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "dependencies": {
    "fitvids": "^2.1.1",
    "jquery": "^3.7.1",
    "jquery-smooth-scroll": "^2.2.0",
    "magnific-popup": "^1.2.0"
  },
  "devDependencies": {
    "uglify-js": "^3.17.4",
    "wrangler": "4.153.0"
  },
  "scripts": {
    "uglify": "uglifyjs node_modules/jquery/dist/jquery.min.js node_modules/fitvids/dist/fitvids.min.js node_modules/magnific-popup/dist/jquery.magnific-popup.min.js node_modules/jquery-smooth-scroll/jquery.smooth-scroll.min.js assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js -c -m -o assets/js/main.min.js",
    "watch:js": "node scripts/watch-js.mjs",
    "build:js": "npm run uglify",
    "build": "LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 bundle exec jekyll build",
    "serve": "LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 bundle exec jekyll serve --config _config.yml,_config.dev.yml",
    "test": "node --test workers/markdown-negotiation/worker.test.mjs"
  },
  "private": true
}
